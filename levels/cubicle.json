    "postload_actions": [
        { "action": "branch", "type": "switchValue", "which": "guard", "value": "justcarried", "operant": "equals", "no": "SkipGuard" },
        { "action": "dialogue", "speaker": "GUARD DEMON", "text": "GWAAHH LET THAT BE A LESSON TO YOU ABOUT THE VALUE OF WORK ETHIC GURRAAH" },
        { "action": "unpausesprite", "sprite": "Guard" },
