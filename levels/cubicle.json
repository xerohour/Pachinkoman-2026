        { "action": "label", "name": "SkipGuard" },
        { "action": "branch", "type": "switchValue", "which": "startedGame", "operant": "yn", "yes": "Skip" },
        { "action": "dialogue", "speaker": "PACHINKO MAN", "text": "Ugh... where am I? Why do I feel so... spherical?", "cage": "I'll be darn tootin' - what the heck is goin' on around here?", "portrait": "pman_normal" },
        { "action": "dialogue", "speaker": "???", "text": "BWAHAHAHA! WELCOME TO BALL HELL, FOOLISH MORTAL. YOU HAVE BEEN CURSED WITH THE FORM OF THAT WHICH YOU ONCE LOVED!", "portrait": "baal" },
        { "action": "dialogue", "speaker": "???", "text": "YOU MIGHT SAY YOU'VE BECOME... A PACHINKO MAN !!!", "portrait": "baal" },
        { "action": "dialogue", "speaker": "PACHINKO MAN", "text": "Augh! How did I get here?!", "cage": "Ah - ah - ah don't understand!!", "portrait": "pman_sweat" },
        { "action": "dialogue", "speaker": "???", "text": "YOU WERE GAMBLING WITH YOUR SOUL, SIMPLETON! THOSE BETS VERY RARELY WORK OUT. AND NOW I, THE DEMON LORD BAAL, OWN YOU!", "portrait": "baal" },
        { "action": "dialogue", "speaker": "BAAL", "text": "YOUR SENTENCE: ONE HUNDRED EONS OF DULL OFFICE LABOR. AN ETERNITY OF AGONY! BOREDOM! AND POSSIBLY CARPAL TUNNEL SYNDROME!", "portrait": "baal" },
        { "action": "dialogue", "speaker": "BAAL", "text": "...ANYWAY, YOU START IMMEDIATELY. GOOD TO HAVE YOU ON BOARD.", "portrait": "baal" },
        { "action": "setswitch", "which": "startedGame", "value": true },
        { "action": "label", "name": "Skip" },
        { "action": "end" }
    ],
