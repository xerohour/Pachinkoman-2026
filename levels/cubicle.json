        "Computer": {
            "left": 168,
            "top": 100,
            "width": 60,
            "height": 100,
            "label": "Inconsolable CPU",
            "default_actions": [
                { "action": "dialogue", "speaker": "INCONSOLABLE CPU", "text": "Oh... hello. *sniff* I guess I'm your Computer. Where would you like to go today? I hope it's hell. Because we're both stuck here. *sob*" },
                { "action": "label", "name": "choices" },
                { "action": "option", "text": "Surf the Net", "label": "Surf" },
                { "action": "option", "text": "Games Folder", "label": "Games" },
                { "action": "option", "text": "Bash Shell", "label": "Bash" },
                { "action": "option", "text": "Log Out", "label": "Skip" },
                { "action": "dialogue", "speaker": "INCONSOLABLE CPU", "text": "You're leaving already? Was it something I did?! I tried so hard... *whimper*" },
                { "action": "end" },
                { "action": "label", "name": "Surf" },
                { "action": "dialogue", "speaker": "INCONSOLABLE CPU", "text": "I don't think that's a good idea... the company firewall blocks everything except a website with a bunch of cat pictures." },
                { "action": "dialogue", "speaker": "PACHINKO MAN", "text": "That seems surprisingly benevolent, actually.", "portrait": "pman_normal" },
                { "action": "dialogue", "speaker": "BAAL", "text": "ALL OF THE CATS ARE DEAD.", "portrait": "baal" },
                { "action": "branch", "type": "always", "jumpto": "choices" },
                { "action": "label", "name": "Games" },
                { "action": "dialogue", "speaker": "INCONSOLABLE CPU", "text": "The only game anyone bothered to install on me was an illegal copy of 'Resident Evil'. The port for the Gameboy Color. *moan*" },
                { "action": "branch", "type": "always", "jumpto": "choices" },
                { "action": "label", "name": "Bash" },
                { "action": "dialogue", "speaker": "INCONSOLABLE CPU", "text": "People are always bashing me and my shell. *weep* I guess there's no reason why you should be different. *lip quiver*" },
                { "action": "branch", "type": "always", "jumpto": "choices" }
            ]
        },
