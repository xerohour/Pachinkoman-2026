				{ "action": "branch", "type": "playerField", "which": "mirror", "operant": "yn", "yes": "IsMirror" },
				{ "action": "branch", "type": "playerField", "which": "cage", "operant": "yn", "yes": "IsCage" },
				
				{ "action": "dialogue", "speaker": "BAAL", "text": "SO! THAT WAS PACHINKO MAN. \n PRETTY NEAT GAME, RIGHT?", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "I BET YOU ALL GOT A GOOD SOLID 40 HOURS OF GAMEPLAY OUT OF IT. (NOTE THAT IN YOUR REVIEWS, GAMES JOURNALISTS!)", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "BUT YOU KNOW, THIS LIL' NUMBER'S GOT PLENTY OF SECRETS YOU MIGHT MISS YOUR FIRST TIME THROUGH.", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "YOU SHOULD GO BACK AND - HUH? \n OH, SOMEONE HANDED ME A MEMO... SAYS HERE NOBODY REPLAYS ADVENTURE GAMES.", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "YEAH, WELL... THAT'S WHY THE PACHINKO MAN TEAM HAS CREATED AN ENTIRELY NEW CAMPAIGN TO PLAY, AFTER YOU FINISHED THIS ONE!", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "I LOOK FORWARD TO TORMENTING YOU AGAIN SOON... IN 'CAGE MATCH' MODE!!", "portrait": "baal" },
				{ "action": "unlock", "which": "cage" },
				{ "action": "unfreeze" },
				{ "action": "gotolevel", "level": "logo", "x": 430, "y": 266 },
				{"action":"end"},
				
				{ "action": "label", "name": "IsCage" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "WOW. YOU... YOU ACTUALLY HAD THE FORTITUDE TO MAKE IT THROUGH CAGE MATCH MODE, HUH?", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "WELL DON'T GO PATTING YOURSELF ON THE BACK JUST YET, MR. COMPLETIONIST!", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "FACT IS, I'VE BEEN KEEPING A THIRD CAMPAIGN SECRET FROM EVERYBODY. ONE THAT WILL TEST REFLEXES, WITS, AND SKILLS ALIKE!", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "THINK YOU'RE A TRUE PACHINKO-MAN OF STEEL? THEN FACE THE CHALLENGE... OF 'MIRROR MODE'!", "portrait": "baal" },
				{ "action": "unlock", "which": "mirror" },
				{ "action": "unfreeze" },
				{ "action": "gotolevel", "level": "logo", "x": 430, "y": 266 },
				{"action":"end"},
				
				{ "action": "label", "name": "IsMirror" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "...", "portrait": "murmur_nomug" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "This isn't an ending.", "portrait": "murmur_nomug" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "Don't expect an ending. Don't expect a hidden mode, a secret, or an achievment.", "portrait": "murmur_nomug" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "Pursue curiousity. Don't use the item you think you're expected to use. Follow the rivulets. Forsake the river.", "portrait": "murmur_nomug" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "Do this, and you will unlock the true secret of Pachinko Man.", "portrait": "murmur_nomug" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "We'll be waiting here for you.", "portrait": "murmur_nomug" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "...", "portrait": "baal" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "WELL THAT WAS PRETENTIOUS.", "portrait": "baal" },
