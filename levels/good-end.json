				{ "action": "spriteani", "sprite": "Murmur", "animation": "normal" },
				{ "action": "spriteani", "sprite": "Projector", "Projector": "normal" },
				{ "action": "dim", "opacity": 0, "speed": 10 },
				{ "action": "wait", "seconds": 1 },
				{ "action": "dialogue", "speaker": "BEELZOTEN", "text": "Origami-tan, I know I'm just a Demon Lord, and you're an Office Manager, but... I have to tell you how I feel...!", "portrait": "beelzoten", "variant": "timed" },
				{ "action": "dialogue", "speaker": "ORIGAMI-TAN", "text": "Uhh, I like, don't think we've met? \n Anyway, I don't date men who are on fire.", "portrait": "origamitan", "variant": "timed" },
				{ "action": "dialogue", "speaker": "BEELZOTEN", "text": "I'm on fire...? Oh COME ON, why does nobody tell me these things!", "portrait": "beelzoten", "variant": "timed" },
				{ "action": "dialogue", "speaker": "MURMUR", "text": "*snickers*", "portrait": "murmur_nomug", "variant": "timed" },
				{ "action": "dim", "opacity": 255, "speed": 10 },
				{ "action": "wait", "frames": 20 },
				{ "action": "spriteani", "sprite": "Origamitan", "animation": "hide" },
				{ "action": "spriteani", "sprite": "Murmur", "animation": "hide" },
				{ "action": "spriteani", "sprite": "Projector", "animation": "hide" },
				
				{ "action": "background", "bg": "credits2" },
				{ "action": "dim", "opacity": 0, "speed": 10 },
				{ "action": "wait", "seconds": 3 },
				{ "action": "dim", "opacity": 255, "speed": 10 },
				{ "action": "wait", "frames": 20 },
				
				{ "action": "background", "bg": "cavern" },
				{ "action": "spriteani", "sprite": "Cerballus", "animation": "normal" },
				{ "action": "spriteani", "sprite": "Morven", "animation": "normal" },
				{ "action": "dim", "opacity": 0, "speed": 10 },
				{ "action": "wait", "seconds": 1 },
				{ "action": "dialogue", "speaker": "MORVEN", "text": "My cover blown... my temple in ruins... that damnable Pachinko Man has set fire to my entire Petty Theft career!", "portrait": "morven_unmasked", "variant": "timed" },
				{ "action": "dialogue", "speaker": "MORVEN", "text": "No matter. I'll start again. I'll rebuild! And no matter how much blood, sweat, and tears it takes, I WILL HAVE REVENGE!", "portrait": "morven_unmasked", "variant": "timed" },
				{ "action": "dialogue", "speaker": "CERBALLUS", "text": "b l o o d  a n d  t e a r s \n s o u n d  t a s t y,\n  w a n  w a n", "portrait": "cerballus", "variant": "timed" },
				{ "action": "dialogue", "speaker": "MORVEN", "text": "Aw, hell.", "portrait": "morven_unmasked", "variant": "timed" },
				{ "action": "dim", "opacity": 255, "speed": 10 },
				{ "action": "wait", "frames": 20 },
				{ "action": "spriteani", "sprite": "Cerballus", "animation": "hide" },
				{ "action": "spriteani", "sprite": "Morven", "animation": "hide" },
				
				{ "action": "background", "bg": "credits3" },
				{ "action": "dim", "opacity": 0, "speed": 10 },
				{ "action": "wait", "seconds": 3 },
				{ "action": "dim", "opacity": 255, "speed": 10 },
				{ "action": "wait", "frames": 20 },
				
				{ "action": "background", "bg": "baalroom" },
				{ "action": "spriteani", "sprite": "Baal", "animation": "normal" },
				{ "action": "spriteani", "sprite": "PinballMan", "animation": "normal" },
				{ "action": "dim", "opacity": 0, "speed": 10 },
				{ "action": "wait", "seconds": 1 },
				{ "action": "dialogue", "speaker": "BAAL", "text": "YOU CAN GO BACK TO YOUR OLD LIFE... \n OR STAY, AND WE CAN RULE BAAL HELL TOGETHER AS PALS! WHAT'LL IT BE?", "portrait": "baal_happy", "variant": "timed" },
				{ "action": "dialogue", "speaker": "PINBALL MAN", "text": "Hmm, I dunno. Corporate leadership might not jive with my lifestyle of Jamming Out.", "portrait": "pinball_chat", "variant": "timed" },
				{ "action": "dialogue", "speaker": "BAAL", "text": "I'LL LET YOU BLAST HARD ROCK OVER THE PA SYSTEM.", "portrait": "baal_neutral", "variant": "timed" },
				{ "action": "dialogue", "speaker": "PINBALL MAN", "text": ". . . \n COME ON, FEEL THE NOISE.", "portrait": "pinball_flag", "variant": "timed" },
				{ "action": "dim", "opacity": 255, "speed": 10 },
				{ "action": "wait", "frames": 20 },
				{ "action": "spriteani", "sprite": "Baal", "animation": "hide" },
				{ "action": "spriteani", "sprite": "PinballMan", "animation": "hide" },
				
